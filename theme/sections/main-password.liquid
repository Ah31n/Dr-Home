<div class="cart-empty page-width">
  <p class="eyebrow" style="justify-content: center;">{{ shop.name }}</p>
  <h1 class="h1">{{ 'general.password_page.opening_soon' | t }}</h1>

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <div class="form-message form-message--error">{{ 'general.password_page.login_form_error' | t }}</div>
    {%- endif -%}
    <div class="field" style="max-width: 380px; margin-inline: auto; text-align: left;">
      <label for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
      <input type="password" id="Password" name="password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" required>
    </div>
    <button type="submit" class="btn btn--primary">{{ 'general.password_page.login_form_submit' | t }}</button>
  {%- endform -%}

  <p style="margin-top: 24px; font-size: 0.9rem;">{{ 'general.password_page.admin_link_html' | t }}</p>
</div>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
