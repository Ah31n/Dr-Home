<div class="page-width section" style="max-width: 720px;">
  <h1 class="h1" data-reveal>{{ 'customer.addresses.title' | t }}</h1>

  <div data-reveal>
    {%- for address in customer.addresses -%}
      <div class="cart-summary" style="margin-bottom: 16px;">
        {%- if address == customer.default_address -%}
          <p class="card__type">{{ 'customer.addresses.default' | t }}</p>
        {%- endif -%}
        <div class="rte">{{ address | format_address }}</div>
        <div style="display: flex; gap: 10px; margin-top: 12px;">
          <details style="flex: 1;">
            <summary class="btn btn--secondary btn--small" style="list-style: none;">{{ 'customer.addresses.edit' | t }}</summary>
            {%- form 'customer_address', address -%}
              {% render 'address-fields', address: address, form: form %}
              <button type="submit" class="btn btn--primary btn--small" style="margin-top: 10px;">{{ 'customer.addresses.update' | t }}</button>
            {%- endform -%}
          </details>
          {%- form 'customer_address', address, class: 'address-delete-form' -%}
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="btn btn--secondary btn--small" onclick="return confirm('{{ 'customer.addresses.delete_confirm' | t }}')">{{ 'customer.addresses.delete' | t }}</button>
          {%- endform -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  <details class="cart-summary" data-reveal>
    <summary class="btn btn--primary" style="list-style: none;">{{ 'customer.addresses.add_new' | t }}</summary>
    {%- form 'customer_address', customer.new_address -%}
      {% render 'address-fields', address: customer.new_address, form: form %}
      <button type="submit" class="btn btn--primary btn--small" style="margin-top: 10px;">{{ 'customer.addresses.add' | t }}</button>
    {%- endform -%}
  </details>

  <p style="margin-top: 28px;"><a class="text-link" href="{{ routes.account_url }}">{% render 'icon', icon: 'chevron-left' %} {{ 'customer.account.title' | t }}</a></p>
</div>

{% schema %}
{
  "name": "Addresses",
  "settings": []
}
{% endschema %}
