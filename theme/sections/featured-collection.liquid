{%- liquid
  assign heading = section.settings.heading
  assign collection = collections[section.settings.collection]
-%}

<section class="section">
  <div class="page-width">
    <div class="section-head section-head--split" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="h2">{{ heading | escape }}</h2>
      </div>
      {%- if section.settings.show_view_all and collection != blank -%}
        <a class="text-link" href="{{ collection.url }}">{{ 'products.product.view_all' | t }} {% render 'icon', icon: 'arrow-right' %}</a>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <ul class="product-grid">
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product, lazy: forloop.index0 | at_least: 2 %}
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="lede">{{ 'collections.general.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "The shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured appliances" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"View all\" link", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
