<article class="page-width section">
  <header class="rich-text" data-reveal>
    <p class="eyebrow" style="justify-content: center;">{{ article.published_at | date: '%b %d, %Y' }} &middot; {{ 'blogs.article.written_by' | t: author: article.author }}</p>
    <h1 class="h1">{{ article.title | escape }}</h1>
  </header>

  {%- if article.image -%}
    <img src="{{ article.image | image_url: width: 1600 }}"
      srcset="{{ article.image | image_url: width: 800 }} 800w, {{ article.image | image_url: width: 1600 }} 1600w"
      sizes="(min-width: 990px) 1100px, 100vw"
      width="1600" height="900"
      style="border-radius: 24px; margin-bottom: 36px;"
      loading="eager"
      alt="{{ article.image.alt | default: article.title | escape }}">
  {%- endif -%}

  <div class="rte" style="max-width: 720px; margin-inline: auto;" data-reveal>
    {{ article.content }}
  </div>

  <p style="text-align: center; margin-top: 40px;">
    <a class="text-link" href="{{ blog.url }}">{% render 'icon', icon: 'chevron-left' %} {{ 'blogs.article.back_to_blog' | t }}</a>
  </p>

  {%- if blog.comments_enabled? -%}
    <div class="rte" style="max-width: 720px; margin: 56px auto 0;">
      <h2 class="h2">{{ 'blogs.article.comments' | t }} ({{ article.comments_count }})</h2>

      {%- for comment in article.comments -%}
        <div style="border-top: 1px solid var(--color-line); padding: 18px 0;">
          <p><strong>{{ comment.author | escape }}</strong> &middot; <small>{{ comment.created_at | date: '%b %d, %Y' }}</small></p>
          <div>{{ comment.content }}</div>
        </div>
      {%- else -%}
        <p>{{ 'blogs.article.no_comments' | t }}</p>
      {%- endfor -%}

      {%- form 'new_comment', article -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error">Please check the form for errors.</div>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <div class="form-message form-message--success">{{ 'blogs.article.moderated' | t }}</div>
        {%- endif -%}
        <h3 class="h3">{{ 'blogs.article.comment_form_title' | t }}</h3>
        <div class="field">
          <label for="CommentAuthor">{{ 'blogs.article.name' | t }}</label>
          <input type="text" id="CommentAuthor" name="comment[author]" required>
        </div>
        <div class="field">
          <label for="CommentEmail">{{ 'blogs.article.email' | t }}</label>
          <input type="email" id="CommentEmail" name="comment[email]" required>
        </div>
        <div class="field">
          <label for="CommentBody">{{ 'blogs.article.message' | t }}</label>
          <textarea id="CommentBody" name="comment[body]" required></textarea>
        </div>
        <button type="submit" class="btn btn--primary">{{ 'blogs.article.post' | t }}</button>
        {%- if blog.moderated? -%}
          <p><small>{{ 'blogs.article.moderated' | t }}</small></p>
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
