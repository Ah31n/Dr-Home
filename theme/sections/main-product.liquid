{%- liquid
  assign product = section.settings.product | default: product
  assign current_variant = product.selected_or_first_available_variant
  assign has_model_media = false
  assign image_count = 0
  for media in product.media
    if media.media_type == 'model'
      assign has_model_media = true
    endif
    if media.media_type == 'image'
      assign image_count = image_count | plus: 1
    endif
  endfor
-%}

{%- comment -%} The 3D module is only ever loaded when a real 3D media asset exists. {%- endcomment -%}
{%- if has_model_media -%}
  <script src="{{ 'product-viewer.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<section class="product-page page-width"
  data-product-section
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}">

  <script type="application/json" data-variants-json>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price }},
          "compareAtPrice": {{ variant.compare_at_price | default: 0 }},
          "sku": {{ variant.sku | json }},
          "featuredMediaId": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  {%- comment -%} ---------- Gallery / stage ---------- {%- endcomment -%}
  <div class="product-gallery{% if section.settings.enable_sticky_buy %} product-gallery--sticky{% endif %}" data-reveal>
    {%- if has_model_media -%}
      <div class="media-toggle" role="group" aria-label="{{ 'products.product.description' | t }}">
        <button type="button" data-media-view="photos" aria-pressed="true">{{ 'products.product.media_photo_view' | t }}</button>
        <button type="button" data-media-view="3d" aria-pressed="false">{{ 'products.product.media_3d_view' | t }}</button>
      </div>
    {%- endif -%}

    <div class="product-stage" data-media-panel="photos" data-product-stage>
      {%- if product.featured_media -%}
        <img class="product-stage__image"
          data-stage-image
          src="{{ product.featured_media | image_url: width: 1100 }}"
          srcset="{{ product.featured_media | image_url: width: 600 }} 600w, {{ product.featured_media | image_url: width: 1100 }} 1100w, {{ product.featured_media | image_url: width: 1600 }} 1600w"
          sizes="(min-width: 990px) 55vw, 92vw"
          width="1100" height="1100"
          alt="{{ product.featured_media.alt | default: product.title | escape }}"
          fetchpriority="high">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    {%- if has_model_media -%}
      <div class="product-stage" data-media-panel="3d" hidden>
        {%- for media in product.media -%}
          {%- if media.media_type == 'model' -%}
            <div class="product-stage__3d" data-model-viewer-mount>
              <div class="viewer-fallback" data-viewer-fallback hidden>
                <p>{{ 'products.product.media_3d_unavailable' | t }}</p>
              </div>
              <noscript>
                <div class="viewer-fallback"><p>{{ 'products.product.media_3d_unavailable' | t }}</p></div>
              </noscript>
            </div>
            {%- assign model_media = media -%}
            <script type="application/json" data-model-source>
              {
                "glb": "{{ media.sources | where: 'format', 'glb' | map: 'url' | first }}",
                "usdz": "{{ media.sources | where: 'format', 'usdz' | map: 'url' | first }}",
                "poster": "{{ media.preview_image | image_url: width: 1100 }}",
                "alt": {{ media.alt | default: product.title | json }}
              }
            </script>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if product.media.size > 1 -%}
      <div class="product-thumbs" role="listbox" aria-label="{{ 'products.product.description' | t }}">
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' or media.media_type == 'video' or media.media_type == 'external_video' -%}
            <button type="button"
              class="product-thumbs__item"
              role="option"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-thumb
              data-media-id="{{ media.id }}"
              {% if media.media_type == 'image' %}data-src="{{ media | image_url: width: 1600 }}"{% endif %}>
              {%- if media.media_type == 'image' -%}
                <img src="{{ media | image_url: width: 168 }}" width="84" height="84" loading="lazy" alt="{{ media.alt | escape }}">
              {%- else -%}
                <span>{{ media.media_type | upcase }}</span>
              {%- endif -%}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} ---------- Buy box ---------- {%- endcomment -%}
  <div class="buy-box{% if section.settings.enable_sticky_buy %} buy-box--sticky{% endif %}" data-reveal style="--reveal-delay: 100ms">
    {%- if section.settings.show_type and product.type != blank -%}
      <p class="buy-box__type">{{ product.type | escape }}</p>
    {%- endif -%}

    <h1 class="h1">{{ product.title | escape }}</h1>

    <div class="buy-box__price" data-price>
      {% render 'price', product: product, use_variant: true, price_class: 'price--large' %}
    </div>

    <p class="buy-box__tax">{{ 'cart.taxes_and_shipping' | t }}</p>

    {%- form 'product', product, id: 'ProductForm', data-product-form: '' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

      {%- unless product.has_only_default_variant -%}
        <div class="variant-picker" data-variant-picker>
          {%- for option in product.options_with_values -%}
            <fieldset class="variant-picker__option">
              <legend class="variant-picker__label">{{ option.name | escape }} <span>— <span data-selected-value>{{ option.selected_value | escape }}</span></span></legend>
              <div class="variant-pills">
                {%- for value in option.values -%}
                  <input
                    type="radio"
                    id="Option-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                    name="Option-{{ section.id }}-{{ forloop.parentloop.index }}"
                    value="{{ value | escape }}"
                    data-variant-option
                    {% if option.selected_value == value %}checked{% endif %}>
                  <label for="Option-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}">{{ value }}</label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      <p class="availability{% unless current_variant.available %} availability--out{% endunless %}" data-availability>
        {%- if current_variant.available -%}
          {{ 'products.product.in_stock' | t }}
        {%- else -%}
          {{ 'products.product.out_of_stock' | t }}
        {%- endif -%}
      </p>

      <div class="buy-box__actions">
        {% render 'quantity-input', product: product %}
        <button
          type="submit"
          name="add"
          class="btn btn--accent"
          data-add-to-cart
          {% unless current_variant.available %}disabled{% endunless %}>
          <span data-add-to-cart-label>
            {%- if current_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </span>
        </button>
      </div>
    {%- endform -%}

    <p class="buy-box__payment-note">
      {%- if shop.shipping_policy.url or shop.refund_policy.url -%}
        {{ 'cart.taxes_and_shipping' | t }}
        {%- if shop.shipping_policy.url %} &middot; <a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>{% endif -%}
        {%- if shop.refund_policy.url %} &middot; <a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{% endif -%}
      {%- else -%}
        {{ 'cart.taxes_and_shipping' | t }}.
      {%- endif -%}
    </p>

    <div class="accordions">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <details class="accordion" open {{ block.shopify_attributes }}>
                <summary>
                  {{ block.settings.title | default: 'products.product.description' | t }}
                  {% render 'icon', icon: 'plus' %}
                </summary>
                <div class="accordion__content rte">{{ product.description }}</div>
              </details>
            {%- endif -%}
          {%- when 'text' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>
                {{ block.settings.title | escape }}
                {% render 'icon', icon: 'plus' %}
              </summary>
              <div class="accordion__content rte">{{ block.settings.content }}</div>
            </details>
        {%- endcase -%}
      {%- endfor -%}

      {%- if section.settings.show_sku and current_variant.sku != blank -%}
        <details class="accordion">
          <summary>
            {{ 'products.product.sku_label' | t }}
            {% render 'icon', icon: 'plus' %}
          </summary>
          <div class="accordion__content"><span data-sku>{{ current_variant.sku }}</span></div>
        </details>
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%} Structured data from the real Shopify records {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if product.featured_media %}
      "image": [{{ product.featured_media | image_url: width: 1200 | prepend: request.origin | json }}],
    {% endif %}
    "description": {{ product.description | default: product.title | strip_html | json }},
    {% if product.selected_or_first_available_variant.sku != blank %}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {% endif %}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "url": {{ request.origin | append: variant.url | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition"
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "checkbox", "id": "show_type", "label": "Show product type", "default": true },
    { "type": "checkbox", "id": "show_sku", "label": "Show SKU", "default": false },
    { "type": "checkbox", "id": "enable_sticky_buy", "label": "Stick panels while scrolling", "default": true }
  ],
  "blocks": [
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Description" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Details" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add approved store content here.</p>" }
      ]
    }
  ],
  "default": {
    "blocks": [{ "type": "description" }]
  }
}
{% endschema %}
