<div class="page-width section">
  <p><a class="text-link" href="{{ routes.account_url }}">{% render 'icon', icon: 'chevron-left' %} {{ 'customer.account.title' | t }}</a></p>
  <h1 class="h1" data-reveal>{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p data-reveal>{{ 'customer.order.date_html' | t: date: order.created_at | date: '%B %d, %Y' }}</p>

  {%- if order.cancelled -%}
    <div class="form-message form-message--error">
      {{ 'customer.order.cancelled_html' | t: date: order.cancelled_at | date: '%B %d, %Y' }}<br>
      {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}
    </div>
  {%- endif -%}

  <table class="cart-table" data-reveal>
    <thead>
      <tr>
        <th scope="col">{{ 'customer.order.product' | t }}</th>
        <th scope="col">{{ 'customer.order.price' | t }}</th>
        <th scope="col">{{ 'customer.order.quantity' | t }}</th>
        <th scope="col" class="cart-right">{{ 'customer.order.total' | t }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td>
            {%- if line_item.url != blank -%}
              <a class="text-link" href="{{ line_item.url }}">{{ line_item.title | escape }}</a>
            {%- else -%}
              {{ line_item.title | escape }}
            {%- endif -%}
          </td>
          <td>{{ line_item.final_price | money }}</td>
          <td>{{ line_item.quantity }}</td>
          <td class="cart-right"><strong>{{ line_item.final_line_price | money }}</strong></td>
        </tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr>
        <td colspan="3">{{ 'customer.order.subtotal' | t }}</td>
        <td class="cart-right">{{ order.line_items_subtotal_price | money }}</td>
      </tr>
      {%- for shipping_method in order.shipping_methods -%}
        <tr>
          <td colspan="3">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td>
          <td class="cart-right">{{ shipping_method.price | money }}</td>
        </tr>
      {%- endfor -%}
      {%- for tax_line in order.tax_lines -%}
        <tr>
          <td colspan="3">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td>
          <td class="cart-right">{{ tax_line.price | money }}</td>
        </tr>
      {%- endfor -%}
      <tr>
        <td colspan="3"><strong>{{ 'customer.order.total' | t }}</strong></td>
        <td class="cart-right"><strong>{{ order.total_price | money }} {{ order.currency }}</strong></td>
      </tr>
    </tfoot>
  </table>

  <div class="cart-page__grid">
    <div class="cart-summary" data-reveal>
      <h2 class="h3">{{ 'customer.order.billing_address' | t }}</h2>
      <div class="rte">{{ order.billing_address | format_address }}</div>
    </div>
    <div class="cart-summary" data-reveal>
      <h2 class="h3">{{ 'customer.order.shipping_address' | t }}</h2>
      <div class="rte">{{ order.shipping_address | format_address }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Order",
  "settings": []
}
{% endschema %}
